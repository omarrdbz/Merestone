{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Merestone examples 3.0",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "revision": {
        "type": "string",
        "minLength": 1
      },
      "kind": {
        "type": "string"
      },
      "technique_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "payload": {
        "type": "string"
      },
      "setup": {
        "type": "array"
      },
      "procedure": {
        "type": "array"
      },
      "oracle": {
        "type": "string"
      },
      "differences": {
        "type": "string"
      },
      "execution_status": {
        "type": "string"
      }
    },
    "required": [
      "id",
      "revision",
      "technique_ids"
    ],
    "additionalProperties": false
  }
}
